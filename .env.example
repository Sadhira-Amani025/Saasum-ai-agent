# SaaSsum AI Commerce
# Use the Java backend and Vite frontend from their own folders.
# For production deployment, deploy the backend as a web service and the frontend as a static site.

# Backend environment variables
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI fallback
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional database override for Supabase/Postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_password

# If you deploy the backend to Render, set PORT in the Render dashboard.
# The app will use PORT automatically when available.
