# ===================================================
# Prompt2Web AI - Backend Environment Configuration
# ===================================================

# Choose either Google Gemini (Option 1) or OpenAI (Option 2)

# OPTION 1: Google Gemini API (Recommended)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OPTION 2: OpenAI API (or compatible services: Groq, OpenRouter, Ollama)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server Port
PORT=5000
